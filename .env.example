# ---------------------------------------------------------------------------
# Sentiment Lab — environment template
# Copy to .env and fill in your own values. NEVER commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# YouTube Data API v3 key. Required only for the YouTube source.
# Get one at https://console.cloud.google.com/ ->
#   Create project -> APIs & Services -> Library -> "YouTube Data API v3"
#   -> Enable -> Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Multilingual sentiment model (Hugging Face). Any sequence-classification
# model with positive/neutral/negative labels works.
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment

# Set to 0 to run VADER-only and skip the transformer entirely.
ENABLE_MULTILINGUAL=1

# --- Dev server ------------------------------------------------------------
# Set FLASK_DEBUG=0 and a real SECRET_KEY in production.
# FLASK_DEBUG=1
# HOST=0.0.0.0
# PORT=5000
# SECRET_KEY=generate_your_own_with_python_secrets_token_hex_32

# --- Optional tuning -------------------------------------------------------
# MAX_UPLOAD_MB=10
# PREVIEW_ROW_LIMIT=1000
# MAX_TEXT_LENGTH=20000
# MAX_ROWS=50000
# YOUTUBE_HARD_LIMIT=10000
# MULTILINGUAL_BATCH_SIZE=32
# REQUEST_TIMEOUT=15
